{
  "name": "rationalgrid-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx src/index.ts",
    "build:ui": "node build-ui.mjs",
