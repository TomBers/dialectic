<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <% canonical_url =
      assigns[:canonical_url] || DialecticWeb.Endpoint.url() <> (@conn.request_path || "") %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:page_description] ||
          "RationalGrid is your AI workshop. Explore questions, organise knowledge, and build understanding together."
      }
    />
    <%= if assigns[:noindex] do %>
      <meta name="robots" content="noindex, nofollow" />
    <% end %>
    <link rel="canonical" href={canonical_url} />
    <meta property="og:url" content={canonical_url} />
    <meta property="og:site_name" content="RationalGrid" />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta
      property="og:title"
      content={assigns[:page_title] || "RationalGrid — Your AI workshop"}
    />
    <meta
      property="og:description"
      content={
        assigns[:page_description] ||
          "RationalGrid is your AI workshop. Explore questions, organise knowledge, and build understanding together."
      }
    />
    <%= if assigns[:og_image] do %>
      <meta property="og:image" content={@og_image} />
      <meta name="twitter:image" content={@og_image} />
    <% end %>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical_url} />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || "RationalGrid — Your AI workshop"}
    />
    <meta
      name="twitter:description"
      content={
        assigns[:page_description] ||
          "RationalGrid is your AI workshop. Explore questions, organise knowledge, and build understanding together."
      }
    />

    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= raw(@json_ld) %>
      </script>
    <% end %>

    <.live_title
      default="RationalGrid"
      suffix={assigns[:page_title_suffix] || " — Your AI workshop"}
    >
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16.png"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body
    class="bg-white"
    data-auth-analytics-event={Phoenix.Flash.get(@flash, :analytics_auth_event)}
  >
    <a
      id="skip-to-main"
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-2 focus:z-[10001] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-slate-950 focus:outline-2 focus:outline-teal-700"
    >
      Skip to main content
    </a>
    <% active_path = @conn.request_path %>
    <header
      :if={active_path != "/ambassadors"}
      class="fixed inset-x-0 top-0 z-[9999] h-10 border-b border-slate-700 bg-slate-950 text-white"
      id="userHeader"
    >
      <DialecticWeb.SiteNavigation.nav current_user={@current_user} active_path={active_path} />
    </header>
    <div :if={active_path != "/ambassadors"} id="userHeaderSpacer" class="h-10" aria-hidden="true">
    </div>

    <div id="page-content">
      {@inner_content}
    </div>
  </body>
</html>
