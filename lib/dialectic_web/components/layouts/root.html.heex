<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <% canonical_url =
      assigns[:canonical_url] || DialecticWeb.Endpoint.url() <> (@conn.request_path || "") %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:page_description] ||
          "Ask a question, map the answer, and challenge any branch while keeping its original context with RationalGrid."
      }
    />
    <%= if assigns[:noindex] do %>
      <meta name="robots" content="noindex, nofollow" />
    <% end %>
    <link rel="canonical" href={canonical_url} />
    <meta property="og:url" content={canonical_url} />
    <meta property="og:site_name" content="RationalGrid" />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta
      property="og:title"
      content={assigns[:page_title] || "RationalGrid — Branching maps for difficult questions"}
    />
    <meta
      property="og:description"
      content={
        assigns[:page_description] ||
          "Ask a question, map the answer, and challenge any branch while keeping its original context with RationalGrid."
      }
    />
    <%= if assigns[:og_image] do %>
      <meta property="og:image" content={@og_image} />
      <meta name="twitter:image" content={@og_image} />
    <% end %>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical_url} />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || "RationalGrid — Branching maps for difficult questions"}
    />
    <meta
      name="twitter:description"
      content={
        assigns[:page_description] ||
          "Ask a question, map the answer, and challenge any branch while keeping its original context with RationalGrid."
      }
    />

    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= raw(@json_ld) %>
      </script>
    <% end %>

    <.live_title default="RationalGrid" suffix=" — Questions stay connected">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/webp" href={~p"/images/favicon.webp"} />
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NZDE9PL5FG">
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NZDE9PL5FG');
    </script>
  </head>
  <body class="bg-white">
    <% active_path = @conn.request_path %>
    <header
      class="fixed inset-x-0 top-0 z-[9999] h-10 border-b border-slate-700 bg-slate-950 text-white"
      id="userHeader"
    >
      <nav class="mx-auto flex h-full w-full max-w-7xl items-center justify-between gap-2 px-3 text-xs sm:px-4">
        <div class="flex min-w-0 items-center">
          <.link
            href={~p"/"}
            aria-label="RationalGrid home"
            class="inline-flex h-9 items-center gap-2 border-b-2 border-transparent px-1 text-white transition hover:border-teal-300 hover:text-teal-100"
          >
            <img src={~p"/images/favicon.webp"} alt="" class="h-5 w-5" />
            <span class="hidden font-semibold tracking-tight sm:inline">RationalGrid</span>
          </.link>
        </div>
        <div class="flex h-full items-center gap-0.5 text-slate-300 sm:gap-1">
          <.link
            href={~p"/intro/how"}
            aria-label="Guide"
            title="Guide"
            class={[
              "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
              if(active_path == "/intro/how",
                do: "border-teal-300 text-white",
                else: "border-transparent hover:border-slate-500 hover:text-white"
              )
            ]}
          >
            <.icon name="hero-book-open" class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">Guide</span>
          </.link>
          <.link
            href={~p"/about"}
            aria-label="About"
            title="About"
            class={[
              "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
              if(active_path == "/about",
                do: "border-teal-300 text-white",
                else: "border-transparent hover:border-slate-500 hover:text-white"
              )
            ]}
          >
            <.icon name="hero-information-circle" class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">About</span>
          </.link>
          <.link
            id="global-search-nav-link"
            href={~p"/search"}
            aria-label="Search"
            title="Search"
            class={[
              "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
              if(active_path == "/search",
                do: "border-teal-300 text-white",
                else: "border-transparent hover:border-slate-500 hover:text-white"
              )
            ]}
          >
            <.icon name="hero-magnifying-glass" class="h-3.5 w-3.5" />
            <span class="hidden md:inline">Search</span>
          </.link>
          <.link
            href={~p"/community"}
            aria-label="Community"
            title="Community"
            class={[
              "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
              if(active_path == "/community",
                do: "border-teal-300 text-white",
                else: "border-transparent hover:border-slate-500 hover:text-white"
              )
            ]}
          >
            <.icon name="hero-user-group" class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">Community</span>
          </.link>
          <.link
            href={~p"/gallery"}
            aria-label="Gallery"
            title="Gallery"
            class={[
              "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
              if(active_path == "/gallery",
                do: "border-teal-300 text-white",
                else: "border-transparent hover:border-slate-500 hover:text-white"
              )
            ]}
          >
            <.icon name="hero-photo" class="h-3.5 w-3.5" />
            <span class="hidden sm:inline">Gallery</span>
          </.link>
          <.link
            href={~p"/?focus=grid#start-here"}
            class="ml-1 inline-flex h-7 items-center gap-1 rounded-md bg-teal-300 px-2.5 font-semibold text-slate-950 transition hover:bg-teal-200"
          >
            <span>+ New Grid</span>
          </.link>
          <%= if @current_user do %>
            <.link
              href={~p"/activity"}
              aria-label="Activity"
              title="Activity"
              class={[
                "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
                if(active_path == "/activity",
                  do: "border-teal-300 text-white",
                  else: "border-transparent hover:border-slate-500 hover:text-white"
                )
              ]}
            >
              <.icon name="hero-bell" class="h-3.5 w-3.5" />
              <span class="hidden sm:inline">Activity</span>
            </.link>
            <.link
              href={~p"/u/#{@current_user.username}"}
              aria-label="My Profile"
              title="My Profile"
              class={[
                "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
                if(active_path == "/u/#{@current_user.username}",
                  do: "border-teal-300 text-white",
                  else: "border-transparent hover:border-slate-500 hover:text-white"
                )
              ]}
            >
              <.icon name="hero-user-circle" class="h-3.5 w-3.5" />
              <span class="hidden sm:inline">My Profile</span>
            </.link>
            <%= if @current_user.is_admin do %>
              <.link
                href={~p"/admin/curated"}
                aria-label="Curate"
                title="Curate"
                class={[
                  "inline-flex h-full items-center gap-1 border-b-2 px-1.5 font-medium transition sm:px-2",
                  if(active_path == "/admin/curated",
                    do: "border-teal-300 text-white",
                    else: "border-transparent hover:border-slate-500 hover:text-white"
                  )
                ]}
              >
                <.icon name="hero-star" class="h-3.5 w-3.5" />
                <span class="hidden sm:inline">Curate</span>
              </.link>
            <% end %>
          <% else %>
            <.link
              href={~p"/users/register"}
              class="hidden h-full items-center border-b-2 border-transparent px-2 font-medium text-slate-300 transition hover:border-slate-500 hover:text-white sm:inline-flex"
            >
              Register
            </.link>
            <.link
              href={~p"/users/log_in"}
              class="inline-flex h-full items-center border-b-2 border-transparent px-2 font-medium text-slate-300 transition hover:border-slate-500 hover:text-white"
            >
              Log in
            </.link>
          <% end %>
        </div>
      </nav>
    </header>
    <div id="userHeaderSpacer" class="h-10" aria-hidden="true"></div>

    <div id="page-content">
      {@inner_content}
    </div>
  </body>
</html>
