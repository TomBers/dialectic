<div class="min-h-screen bg-[#f4f1e9] text-slate-950">
  <header id="elicit-comparison-hero" class="border-b border-stone-300 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <p class="border-l-2 border-teal-700 pl-3 text-xs font-semibold uppercase tracking-[0.2em] text-teal-800">
        Elicit alternative for argument mapping
      </p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl">
        Find the literature—or map the inquiry?
      </h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        <a
          href="https://elicit.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-teal-800 underline decoration-teal-600 underline-offset-4"
        >Elicit</a>
        is designed to find and analyse scientific literature. RationalGrid helps you explore a question and preserve the answers, challenges, evidence, sources, notes, and further questions that emerge.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          id="elicit-start-cta"
          href="/?focus=grid#start-here"
          data-analytics-event="comparison_start_grid_clicked"
          data-analytics-comparison="elicit"
          data-analytics-placement="hero"
          class="inline-flex items-center gap-2 rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Start a grid <.icon name="hero-arrow-right" class="h-4 w-4" />
        </a>
        <a
          id="elicit-ai-link"
          href="/intro/ai"
          class="inline-flex items-center gap-2 border-b border-slate-500 px-1 py-2 text-sm font-semibold transition hover:border-teal-700 hover:text-teal-800"
        >
          How RationalGrid uses AI <.icon name="hero-arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <section id="elicit-verdict" aria-labelledby="elicit-verdict-heading">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-800">Short verdict</p>
      <h2
        id="elicit-verdict-heading"
        class="mt-2 font-serif text-4xl font-semibold tracking-tight"
      >
        These tools solve different parts of the research process.
      </h2>
      <p class="mt-4 leading-7 text-slate-600">
        Choose Elicit when you need dedicated paper search, screening, extraction, or systematic-review workflows. Choose RationalGrid when you want to examine and communicate how questions, competing explanations, challenges, and evidence connect. They can also be used together.
      </p>
    </section>

    <section id="elicit-at-a-glance" class="mt-14" aria-labelledby="elicit-table-heading">
      <h2 id="elicit-table-heading" class="font-serif text-4xl font-semibold tracking-tight">
        At a glance
      </h2>
      <div class="mt-6 overflow-x-auto border border-stone-300 bg-white">
        <table id="elicit-comparison-table" class="w-full min-w-[48rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-stone-300 bg-stone-100">
              <th class="px-5 py-4 text-sm font-semibold">Research need</th>
              <th class="px-5 py-4 text-sm font-semibold">Elicit</th>
              <th class="bg-teal-950 px-5 py-4 text-sm font-semibold text-white">RationalGrid</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-300 text-sm leading-6">
            <%= for {need, elicit, grid} <- [
              {"Primary purpose", "Scientific-literature search, analysis, and review workflows.", "AI-assisted exploration of connected questions and ideas."},
              {"Discover papers", "Searches a large index of scientific literature.", "Does not provide a comparable dedicated paper-search index."},
              {"Screen and extract", "Supports screening and structured data extraction for literature reviews.", "Does not provide a comparable systematic-review or PDF-extraction workflow."},
              {"Core output", "Research reports, tables, analyses, and an organised source library.", "Shareable grids of questions, answers, challenges, evidence, sources, and notes."},
              {"Follow competing paths", "Synthesises evidence through research workflows.", "Branches competing explanations and questions from the exact ideas they address."},
              {"Pricing", "Free and paid options; check Elicit for current plans and limits.", "Free with no paid tiers currently; published usage limits apply."}
            ] do %>
              <tr>
                <th scope="row" class="bg-[#f8f6f0] px-5 py-4 align-top font-semibold">{need}</th>
                <td class="px-5 py-4 align-top text-slate-600">{elicit}</td>
                <td class="px-5 py-4 align-top text-slate-700">{grid}</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section
      id="elicit-strengths"
      class="mt-14 grid gap-5 md:grid-cols-2"
      aria-label="What each option does well"
    >
      <article class="border-t-4 border-emerald-600 bg-white p-6">
        <.icon name="hero-document-magnifying-glass" class="h-6 w-6 text-emerald-700" />
        <h2 class="mt-4 font-serif text-3xl font-semibold">What Elicit does well</h2>
        <p class="mt-3 leading-7 text-slate-600">
          Elicit provides purpose-built workflows for finding scientific papers, screening literature, extracting structured information, and producing cited research outputs. That makes it the stronger fit when the document set itself is the main workload.
        </p>
      </article>
      <article class="border-t-4 border-teal-700 bg-slate-950 p-6 text-white">
        <.icon name="hero-share" class="h-6 w-6 text-teal-300" />
        <h2 class="mt-4 font-serif text-3xl font-semibold">What RationalGrid does well</h2>
        <p class="mt-3 leading-7 text-slate-300">
          RationalGrid keeps the path of inquiry visible. A question can branch into answers, a claim into challenges and evidence, and a difficult point into another question without separating it from the context that prompted it.
        </p>
      </article>
    </section>

    <section
      id="elicit-choose"
      class="mt-14 border-y border-stone-300 py-10"
      aria-labelledby="elicit-choose-heading"
    >
      <h2 id="elicit-choose-heading" class="font-serif text-4xl font-semibold tracking-tight">
        Which should you choose?
      </h2>
      <div class="mt-7 grid gap-7 lg:grid-cols-3">
        <div>
          <h3 class="text-lg font-semibold">Choose Elicit if…</h3>
          <ul class="mt-3 space-y-3 text-slate-600">
            <li>• You need semantic search across scientific literature.</li>
            <li>• You need to screen papers for a systematic review.</li>
            <li>• You want structured extraction across many papers.</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Choose RationalGrid if…</h3>
          <ul class="mt-3 space-y-3 text-slate-600">
            <li>• You already have a question or body of material to examine.</li>
            <li>• Challenges, evidence, and sources should stay connected to specific ideas.</li>
            <li>• You want a shareable map of how the inquiry developed.</li>
          </ul>
        </div>
        <div class="border-l-2 border-teal-700 pl-5">
          <h3 class="text-lg font-semibold">Use both if…</h3>
          <p class="mt-3 leading-7 text-slate-600">
            You want Elicit to help find and analyse relevant literature, then RationalGrid to map the questions, disagreements, evidence, and further paths that arise from it.
          </p>
        </div>
      </div>
    </section>

    <section
      id="elicit-caveat"
      class="mt-12 border border-stone-300 border-l-4 border-l-amber-600 bg-white p-6"
    >
      <h2 class="font-serif text-3xl font-semibold">
        RationalGrid is not a free replica of Elicit.
      </h2>
      <p class="mt-3 leading-7 text-slate-600">
        RationalGrid does not currently replace Elicit's dedicated literature index, PDF extraction, screening, or systematic-review workflows. It is an alternative when the job is to map and revisit an inquiry—not when the job is to reproduce Elicit's full research pipeline without a subscription.
      </p>
    </section>

    <section id="elicit-faq" class="mt-14" aria-labelledby="elicit-faq-heading">
      <h2 id="elicit-faq-heading" class="font-serif text-4xl font-semibold">FAQ</h2>
      <div class="mt-6 divide-y divide-stone-300 border-y border-stone-300">
        <%= for {question, answer} <- [
          {"Is RationalGrid a replacement for Elicit?", "Not for Elicit's complete workflow. RationalGrid does not currently offer comparable paper search, screening, PDF extraction, or systematic-review tooling."},
          {"Can RationalGrid search academic papers like Elicit?", "No. RationalGrid can generate source-grounded branches, but it does not provide a comparable dedicated index and semantic paper-search workflow."},
          {"Can RationalGrid extract data from uploaded PDFs?", "Not as a dedicated batch-extraction workflow. If extracting structured fields across papers is your task, Elicit is the more appropriate tool."},
          {"Can I use Elicit and RationalGrid together?", "Yes. Use Elicit to discover and analyse literature, then use RationalGrid to map selected questions, claims, objections, evidence, and follow-up paths."},
          {"Is RationalGrid free?", "Yes. RationalGrid currently has no paid pricing tiers. Published concurrency and request-rate limits still apply."}
        ] do %>
          <details class="py-5">
            <summary class="cursor-pointer font-semibold">{question}</summary>
            <p class="mt-3 leading-7 text-slate-600">{answer}</p>
          </details>
        <% end %>
      </div>
    </section>

    <nav
      id="elicit-related-comparisons"
      class="mt-14 border-t border-stone-300 pt-8"
      aria-label="Related comparisons"
    >
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-800">Keep comparing</p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
        <a
          href="/compare/chatgpt"
          class="text-teal-800 underline decoration-stone-400 underline-offset-4 hover:decoration-teal-700"
        >ChatGPT alternatives for structured research</a>
        <a
          href="/compare/kialo"
          class="text-teal-800 underline decoration-stone-400 underline-offset-4 hover:decoration-teal-700"
        >Explore a free Kialo alternative</a>
        <a
          href="/compare/mind-maps"
          class="text-teal-800 underline decoration-stone-400 underline-offset-4 hover:decoration-teal-700"
        >Argument maps vs mind maps</a>
      </div>
    </nav>

    <section id="elicit-final-cta" class="mt-14 bg-teal-950 p-7 text-white sm:p-10">
      <h2 class="font-serif text-4xl font-semibold">
        Give the research a structure you can revisit.
      </h2>
      <p class="mt-3 leading-7 text-teal-100">
        Start with one question, then keep the answers, challenges, evidence, and sources connected.
      </p>
      <a
        id="elicit-final-cta-link"
        href="/?focus=grid#start-here"
        data-analytics-event="comparison_start_grid_clicked"
        data-analytics-comparison="elicit"
        data-analytics-placement="final_cta"
        class="mt-6 inline-flex items-center gap-2 rounded-md bg-teal-300 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-teal-200"
      >
        Start a free grid <.icon name="hero-arrow-right" class="h-4 w-4" />
      </a>
    </section>
  </main>
</div>
