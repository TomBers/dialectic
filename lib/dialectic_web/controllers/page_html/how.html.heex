<div class="min-h-screen bg-[#f4f1e9] text-slate-950">
  <section class="border-b border-stone-300 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <p class="border-l-2 border-teal-700 pl-3 text-xs font-semibold uppercase tracking-[0.2em] text-teal-800">
        How RationalGrid works
      </p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl">
        Turn one question into a map of ideas you can examine and share.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        Use AI to explore, critical thinking tools to challenge, and the grid to preserve what is worth keeping.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          id="guide-start-grid-link"
          href="/?focus=grid#start-here"
          class="inline-flex items-center gap-2 rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Start a grid <.icon name="hero-arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="#guide-flow"
          class="inline-flex items-center gap-2 border-b border-slate-500 px-1 py-2 text-sm font-semibold text-slate-900 transition hover:border-teal-700 hover:text-teal-800"
        >
          Follow the flow <.icon name="hero-arrow-down" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
    <section
      id="guide-flow"
      class="relative isolate overflow-hidden border border-slate-700 bg-slate-950 px-5 py-7 text-white shadow-[0_24px_60px_-42px_rgba(15,23,42,0.9)] sm:px-8 sm:py-9"
      aria-labelledby="guide-flow-heading"
    >
      <div
        aria-hidden="true"
        class="absolute -right-24 -top-28 -z-10 h-72 w-72 rounded-full bg-indigo-500/15 blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="absolute -bottom-28 -left-20 -z-10 h-64 w-64 rounded-full bg-teal-400/10 blur-3xl"
      >
      </div>

      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.85fr)_minmax(18rem,1.15fr)] lg:items-end">
        <div>
          <p class="border-l-2 border-teal-300 pl-3 text-xs font-semibold uppercase tracking-[0.18em] text-teal-200">
            The core loop
          </p>
          <h2
            id="guide-flow-heading"
            class="mt-3 font-serif text-4xl font-semibold tracking-tight sm:text-5xl"
          >
            What happens inside a grid?
          </h2>
        </div>
        <p class="max-w-xl leading-7 text-slate-300 lg:justify-self-end">
          Each question branches from an existing idea and keeps its context. You choose what to explore next.
        </p>
      </div>

      <ol class="mt-8 grid overflow-hidden border border-white/15 bg-white/10 sm:grid-cols-2 lg:grid-cols-6">
        <%= for {number, slug, title, copy, tone} <- [
          {"1", "ask", "Ask", "Name the question or topic.", "border-sky-300/40 bg-sky-300/10 text-sky-200"},
          {"2", "read", "Read", "Follow the response in context.", "border-cyan-300/40 bg-cyan-300/10 text-cyan-200"},
          {"3", "branch", "Branch", "Ask AI or add your contribution.", "border-violet-300/40 bg-violet-300/10 text-violet-200"},
          {"4", "examine", "Examine", "Use critical thinking tools.", "border-rose-300/40 bg-rose-300/10 text-rose-200"},
          {"5", "keep", "Keep", "Star nodes and save passages.", "border-amber-300/40 bg-amber-300/10 text-amber-200"},
          {"6", "share", "Share", "Edit together or publish.", "border-emerald-300/40 bg-emerald-300/10 text-emerald-200"}
        ] do %>
          <li
            id={"guide-flow-step-#{slug}"}
            class="relative min-h-36 border-b border-white/10 bg-slate-950/70 p-4 last:border-b-0 sm:[&:nth-child(odd)]:border-r lg:border-b-0 lg:border-r lg:last:border-r-0"
          >
            <div class="flex items-center gap-3">
              <span class={[
                "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-bold",
                tone
              ]}>
                {number}
              </span>
              <span
                :if={number != "6"}
                aria-hidden="true"
                class="hidden h-px flex-1 bg-gradient-to-r from-white/30 to-white/5 lg:block"
              >
              </span>
            </div>
            <h3 class="mt-5 text-base font-semibold text-white">{title}</h3>
            <p class="mt-1 text-sm leading-5 text-slate-400">{copy}</p>
          </li>
        <% end %>
      </ol>
    </section>

    <section class="mt-12" aria-labelledby="guide-ask-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">Step 1 · Ask</p>
        <h2 id="guide-ask-heading" class="mt-2 font-serif text-4xl font-semibold tracking-tight">
          What would you like to explore?
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Choose a prompt or start with your own.
        </p>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <%= for {label, category, prompt} <- [
          {"Should cities expand digital surveillance in public spaces?", "Trade-offs", "Should cities expand digital surveillance in public spaces, and what are the trade-offs?"},
          {"How do recommendation algorithms shape what people see?", "Systems", "How do recommendation algorithms shape what people see online?"},
          {"What makes a good team decision?", "Organisations", "What makes a good team decision, and which biases get in the way?"},
          {"What are the strongest arguments for universal basic income?", "Policy", "What are the strongest arguments for and against universal basic income?"},
          {"Is eating meat ethically defensible?", "Ethics", "Is eating meat ethically defensible, and what are the strongest arguments on each side?"},
          {"Which concerns about AI adoption hold up?", "Technology", "What are the strongest objections to AI adoption, and which concerns matter most?"}
        ] do %>
          <a
            href={"/?#{URI.encode_query(%{"initial_prompt" => prompt, "focus" => "grid"})}#start-here"}
            class="group border border-stone-300 border-l-4 border-l-teal-700 bg-white p-5 shadow-sm transition hover:border-slate-500"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">{category}</p>
            <p class="mt-2 text-sm font-semibold leading-6 text-slate-950 group-hover:text-teal-800">
              {label}
            </p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 group-hover:text-teal-700">
              <.icon name="hero-arrow-right" class="h-3.5 w-3.5" /> Open this question
            </span>
          </a>
        <% end %>
      </div>
      <div class="mt-5 border border-stone-300 bg-white p-5 sm:flex sm:items-center sm:justify-between sm:gap-5">
        <div>
          <p class="text-sm font-semibold text-teal-950">Have your own question?</p>
          <p class="mt-1 text-sm text-teal-900">
            Start with it now.
          </p>
        </div>
        <a
          id="guide-own-question-link"
          href="/?focus=grid#start-here"
          class="mt-4 inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800 sm:mt-0"
        >
          <.icon name="hero-plus" class="h-4 w-4" /> Ask your own question
        </a>
      </div>
      <div
        id="guide-explanation-level"
        class="mt-3 flex gap-3 border border-stone-300 bg-[#f8f6f0] p-5"
      >
        <.icon name="hero-adjustments-horizontal" class="mt-0.5 h-5 w-5 shrink-0 text-indigo-700" />
        <div>
          <h3 class="text-sm font-semibold text-slate-950">Choose the explanation level</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">
            Set the grid to <strong>Simple</strong>, <strong>High School</strong>, <strong>University</strong>, or <strong>Expert</strong>. New AI answers use that language and depth. Change it later under <strong>Settings → AI Responses</strong>.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-12 grid gap-6 lg:grid-cols-[1.1fr,0.9fr] lg:items-center"
      aria-labelledby="guide-response-heading"
    >
      <figure class="order-2 overflow-hidden border border-slate-300 bg-slate-950 p-3 shadow-sm lg:order-1">
        <img
          src="/images/guide/grid-workspace.webp"
          alt="RationalGrid workspace showing a connected response map"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="px-2 pt-3 text-xs text-slate-300">
          A response becomes a set of connected nodes you can read and revisit.
        </figcaption>
      </figure>
      <div class="order-1 lg:order-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">Step 2 · Read</p>
        <h2
          id="guide-response-heading"
          class="mt-2 font-serif text-4xl font-semibold tracking-tight"
        >
          Read each answer in context.
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Select a node to read it, follow its links, or branch from that point.
        </p>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
          <li class="flex gap-3">
            <.icon name="hero-cursor-arrow-rays" class="mt-1 h-4 w-4 shrink-0 text-teal-700" />
            <span>
              <strong>Select a node</strong> to read it.
            </span>
          </li>
          <li class="flex gap-3">
            <.icon name="hero-document-text" class="mt-1 h-4 w-4 shrink-0 text-teal-700" />
            <span>
              <strong>Check its context</strong> before branching.
            </span>
          </li>
          <li class="flex gap-3">
            <.icon name="hero-magnifying-glass" class="mt-1 h-4 w-4 shrink-0 text-teal-700" />
            <span>
              <strong>Switch to Read</strong> for a linear pass.
            </span>
          </li>
          <li id="guide-translate-node" class="flex gap-3">
            <.icon name="hero-language" class="mt-1 h-4 w-4 shrink-0 text-teal-700" />
            <span>
              <strong>Translate the current node</strong> under Settings → Translate.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="guide-branch-heading">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">Step 3 · Branch</p>
        <h2
          id="guide-branch-heading"
          class="mt-2 font-serif text-4xl font-semibold tracking-tight"
        >
          Choose how to go deeper.
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Branch from the idea you are reading. Ask AI or add the next contribution yourself.
        </p>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <article class="border-t-4 border-sky-600 bg-white p-5 shadow-sm">
          <.icon name="hero-question-mark-circle" class="h-5 w-5 text-sky-600" />
          <h3 class="mt-3 text-base font-semibold">Ask AI</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Generate a response connected to the selected node.
          </p>
        </article>
        <article class="border-t-4 border-teal-600 bg-white p-5 shadow-sm">
          <.icon name="hero-chat-bubble-bottom-center-text" class="h-5 w-5 text-teal-600" />
          <h3 class="mt-3 text-base font-semibold">Comment</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Add your claim, objection, example, or question.
          </p>
        </article>
        <article class="border-t-4 border-amber-600 bg-white p-5 shadow-sm">
          <.icon name="hero-cursor-arrow-rays" class="h-5 w-5 text-amber-600" />
          <h3 class="mt-3 text-base font-semibold">Select a phrase</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Open focused actions for one sentence or idea.
          </p>
        </article>
        <article class="border-t-4 border-indigo-600 bg-white p-5 shadow-sm">
          <.icon name="hero-squares-plus" class="h-5 w-5 text-indigo-600" />
          <h3 class="mt-3 text-base font-semibold">Find related ideas</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Explore nearby concepts and adjacent directions.
          </p>
        </article>
      </div>
    </section>

    <section
      class="mt-12 border border-slate-700 bg-slate-950 p-6 text-white shadow-sm sm:p-8"
      aria-labelledby="guide-examine-heading"
    >
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-300">
          Step 4 · Examine
        </p>
        <h2
          id="guide-examine-heading"
          class="mt-2 font-serif text-4xl font-semibold tracking-tight"
        >
          Examine the idea.
        </h2>
        <p class="mt-3 leading-7 text-slate-300">
          Select a node or passage, then choose the challenge you need.
        </p>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <%= for {icon, title, question, copy} <- [
          {"hero-light-bulb", "Clarify terms", "What do we mean?", "Expose ambiguity and boundaries."},
          {"hero-cube-transparent", "Assumptions", "What has to be true?", "Reveal hidden premises."},
          {"hero-user", "Source check", "Says who?", "Question authority and evidence."},
          {"hero-star", "Steel man", "What is the strongest version?", "Build the fairest argument."},
          {"hero-x-mark", "Counterexample", "Is that always true?", "Find cases that challenge the claim."},
          {"hero-users", "Other perspectives", "Who disagrees?", "Explore opposing viewpoints."},
          {"hero-arrow-trending-up", "Implications", "If true, then what?", "Trace likely consequences."},
          {"hero-eye-slash", "Blind spots", "What are we missing?", "Find overlooked constraints."},
          {"hero-question-mark-circle", "What if", "What could change?", "Explore alternative scenarios."}
        ] do %>
          <article class="border-l-2 border-teal-300 bg-white/[0.06] p-4">
            <.icon name={icon} class="h-5 w-5 text-teal-300" />
            <h3 class="mt-3 text-sm font-semibold">{title}</h3>
            <p class="mt-0.5 text-xs font-medium text-teal-200">{question}</p>
            <p class="mt-1 text-xs leading-5 text-slate-300">{copy}</p>
          </article>
        <% end %>
      </div>
    </section>

    <section
      id="guide-saved-thinking"
      class="mt-12 grid gap-6 lg:grid-cols-[0.9fr,1.1fr] lg:items-center"
      aria-labelledby="guide-keep-heading"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">
          Step 5 · Keep
        </p>
        <h2 id="guide-keep-heading" class="mt-2 font-serif text-4xl font-semibold tracking-tight">
          Build a trail back to useful ideas.
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Save whole nodes or exact passages as you read. Your profile keeps them together so you can return with their context intact.
        </p>
        <div class="mt-5 grid gap-3">
          <div id="guide-star-nodes" class="border-t-2 border-amber-600 bg-white p-4">
            <.icon name="hero-star" class="h-5 w-5 text-amber-600" />
            <h3 class="mt-2 text-sm font-semibold">Star a node</h3>
            <p class="mt-1 text-xs leading-5 text-slate-600">
              Select the star beside a node title. It appears under
              <strong>Bookmarked ideas</strong>
              on your profile, where you can add a note and jump back.
            </p>
          </div>
          <div id="guide-save-highlights" class="border-t-2 border-indigo-600 bg-white p-4">
            <.icon name="hero-bookmark-square" class="h-5 w-5 text-indigo-600" />
            <h3 class="mt-2 text-sm font-semibold">Highlight a passage</h3>
            <p class="mt-1 text-xs leading-5 text-slate-600">
              Select text and choose <strong>Save as a highlight</strong>. The quote, source, and any note are stored under
              <strong>Quotes and notes</strong>
              on your profile.
            </p>
          </div>
          <div id="guide-export-grid" class="border-t-2 border-sky-600 bg-white p-4">
            <.icon name="hero-arrow-down-tray" class="h-5 w-5 text-sky-700" />
            <h3 class="mt-2 text-sm font-semibold">Export the grid</h3>
            <p class="mt-1 text-xs leading-5 text-slate-600">
              Under <strong>Settings → Export</strong>, download Markdown for further note-taking, a PNG snapshot, or JSON for other tools.
            </p>
          </div>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">
          Bookmarks and highlights are part of your private saved-thinking view, not your public profile.
        </p>
      </div>
      <figure class="overflow-hidden border border-slate-300 bg-slate-950 p-3 shadow-sm">
        <img
          src="/images/guide/grid-dense-example.webp"
          alt="A large RationalGrid map with many connected branches"
          class="w-full"
          loading="lazy"
        />
        <figcaption class="px-2 pt-3 text-xs text-slate-300">
          The structure stays clear as the grid grows.
        </figcaption>
      </figure>
    </section>

    <section
      id="guide-collaborate"
      class="mt-12 border border-stone-300 bg-white p-6 shadow-sm sm:p-8"
      aria-labelledby="guide-collaborate-heading"
    >
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">
          Step 6 · Share
        </p>
        <h2
          id="guide-collaborate-heading"
          class="mt-2 font-serif text-4xl font-semibold tracking-tight"
        >
          Work together live, then choose what becomes public.
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          A grid is a shared workspace, not a finished screenshot. Send its URL so other people can follow the context and extend it with you.
        </p>
      </div>

      <div class="mt-6 grid gap-px overflow-hidden border border-stone-300 bg-stone-300 lg:grid-cols-3">
        <article id="guide-live-editing" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-users" class="h-5 w-5 text-emerald-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">Edit together by URL</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Open <strong>Share</strong>, copy the grid URL, and keep <strong>Editing</strong>
            set to <strong>Editable</strong>. People with access can branch and comment in the same live grid. Set it to
            <strong>Locked</strong>
            when you want view-only access.
          </p>
        </article>

        <article id="guide-grid-visibility" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-lock-closed" class="h-5 w-5 text-sky-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">Choose public or private</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Under <strong>Settings → Collaboration</strong>, set <strong>Visibility</strong>
            to <strong>Public</strong>
            or <strong>Private</strong>. Public grids are open to anyone; private share links contain a secure access token, so send them only to people you trust.
          </p>
        </article>

        <article id="guide-public-profile" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-identification" class="h-5 w-5 text-indigo-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">
            Publish through your profile
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Your username gives you a public profile with your bio and public grids. Share it as a growing record of your work. Private grids stay off that page, and saved thinking remains visible only to you.
          </p>
        </article>

        <article id="guide-contribution-history" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-clipboard-document-list" class="h-5 w-5 text-emerald-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">See who added what</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Open <strong>Settings → Activity</strong>
            to see the contributor behind each question, branch, comment, and critical-thinking action. Teachers and teams get a clear record of individual participation.
          </p>
        </article>

        <article id="guide-follow-updates" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-bell" class="h-5 w-5 text-amber-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">Follow future updates</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Select <strong>Follow</strong>
            at the top of a public grid. New contributions appear in your
            <strong>Activity</strong>
            feed; use its <strong>Following</strong>
            tab to manage the grids and people you follow.
          </p>
        </article>

        <article id="guide-focused-sharing" class="bg-[#f8f6f0] p-5">
          <.icon name="hero-cursor-arrow-rays" class="h-5 w-5 text-rose-700" />
          <h3 class="mt-3 text-base font-semibold text-slate-950">
            Share or question exact text
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Select a word or passage to save it as a highlight with its own share URL, or ask about a technical term, book, or topic while preserving the surrounding context.
          </p>
        </article>
      </div>

      <p id="guide-shared-paths" class="mt-5 flex gap-2 text-sm leading-6 text-slate-600">
        <.icon name="hero-link" class="mt-1 h-4 w-4 shrink-0 text-teal-700" />
        <span>
          Share the whole grid or link directly to the current node. Use <strong>Read</strong>
          or <strong>Present</strong>
          when you want to guide someone through a path.
        </span>
      </p>
    </section>

    <section class="mt-12 border border-stone-300 border-l-4 border-l-teal-700 bg-white p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-teal-700">
        Start now
      </p>
      <h2 class="mt-2 font-serif text-4xl font-semibold tracking-tight">
        Ask one question. Follow the next useful branch.
      </h2>
      <p class="mt-3 max-w-2xl leading-7 text-slate-700">
        Learn the other tools as you go.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/?focus=grid#start-here"
          class="inline-flex items-center gap-2 rounded-md bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          <.icon name="hero-plus" class="h-4 w-4" /> Create a grid
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 rounded-md border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-teal-800 transition hover:border-teal-700"
        >
          <.icon name="hero-information-circle" class="h-4 w-4" /> About RationalGrid
        </a>
      </div>
    </section>
  </main>
</div>
