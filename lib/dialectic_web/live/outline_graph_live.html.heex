<Layouts.app flash={@flash}>
  <div
    id="outline-layout"
    phx-hook="GraphLayout"
    class="reading-appearance flex w-full flex-col overflow-hidden bg-[#f4f1e9]"
    style="height: calc(100vh - 2.5rem); height: calc(100dvh - 2.5rem);"
    data-graph-id={@graph_id}
    data-anonymous={to_string(is_nil(@current_user))}
    data-reading-style={@reader_style}
    data-reading-density={@appearance_preferences.reading_density}
    data-reading-font={@appearance_preferences.reading_font}
    data-graph-view-mode={@appearance_preferences.graph_view_mode}
    data-graph-direction={@appearance_preferences.graph_direction}
    data-reduce-motion={if(@appearance_preferences.reduce_motion, do: "true", else: "false")}
  >
    <a
      :if={@selected_node_id}
      id="reader-skip-to-response"
      href={"#reading-node-#{@selected_node_id}"}
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-12 focus:z-[10001] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-slate-950 focus:outline-2 focus:outline-teal-700"
    >
      Skip to current response
    </a>

    <.login_required_modal id="reader-login-modal" show={@show_login_modal} />

    <DialecticWeb.WorkspaceBarComp.workspace_header
      mode={:reader}
      graph_struct={@graph_struct}
      creator={@graph_creator}
      node_id={@selected_node_id}
      nav_params={reader_nav_params(@nav_params, @path_focus_ids)}
      layout_target="#outline-layout"
      current_user={@current_user}
      following_graph?={@following_graph?}
      highlights_count={length(@visible_highlights)}
      return_context={@learning_return}
    />

    <div id="reader-new-thoughts-status" aria-live="polite" aria-atomic="true" class="shrink-0">
      <button
        :if={@new_thought_ids != []}
        id="reader-view-new-thoughts"
        type="button"
        phx-click="view_new_thoughts"
        class="flex min-h-11 w-full items-center justify-center gap-2 bg-teal-50 px-4 py-2 text-sm font-semibold text-teal-900"
      >
        <.icon name="hero-chat-bubble-left-right" class="h-4 w-4" />
        {length(@new_thought_ids)} new {if(length(@new_thought_ids) == 1,
          do: "thought",
          else: "thoughts"
        )} · View latest
      </button>
    </div>

    <DialecticWeb.ReaderMobileNavComp.reader_mobile_nav
      can_edit={@can_edit}
      reader_style={@reader_style}
      highlights_count={length(@visible_highlights)}
      current_user={@current_user}
      following_graph?={@following_graph?}
    />

    <p id="reader-appearance-status" role="status" class="sr-only">
      {@reader_appearance_status}
    </p>

    <div
      id="outline-scroll-shell"
      data-mode-switch-content
      class="reader-scroll-shell relative flex flex-1 min-h-0 flex-col overflow-x-hidden overflow-y-auto lg:grid lg:overflow-clip"
      phx-hook="ReaderScroll"
    >
      <aside
        id="outline-tree"
        aria-label="Conversation outline"
        class="hidden min-h-0 overflow-y-auto border-b border-stone-300 bg-[#f4f1e9] lg:block lg:border-b-0 lg:border-r"
        phx-hook="OutlineNav"
      >
        <div class="sticky top-0 z-10 flex items-center justify-between gap-2 border-b border-stone-300 bg-[#f4f1e9] px-4 py-3">
          <div>
            <h2 class="text-sm font-semibold text-slate-950">Grid outline</h2><p class="mt-1 text-xs text-slate-600">
              Follow an idea that interests you.
            </p>
          </div>
          <button
            id="reader-explore-close"
            type="button"
            phx-click={JS.dispatch("toggle-explore", to: "#outline-layout")}
            aria-label="Hide outline"
            class="inline-flex h-11 w-9 shrink-0 items-center justify-center rounded-md text-slate-600 hover:bg-stone-200"
          ><.icon name="hero-x-mark" class="h-4 w-4" /></button>
        </div>
        <div
          :if={@paths_filtered?}
          class="sticky top-0 z-10 border-b border-slate-200 bg-white px-4 py-2"
        >
          <button
            id="outline-show-all-paths"
            type="button"
            phx-click="show_all_paths"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700 transition hover:border-blue-300 hover:bg-blue-100"
          >
            Show all threads <.icon name="hero-x-mark" class="h-3.5 w-3.5" />
          </button>
        </div>

        <%= if @outline_nodes == [] do %>
          <div id="outline-empty-state" class="px-4 py-12 text-center text-sm text-slate-500">
            This graph does not have any visible nodes yet.
          </div>
        <% else %>
          <DialecticWeb.OutlineNavigation.outline_navigation
            id="outline"
            rows={@visible_outline_nodes}
            selected_id={@selected_node_id}
            expanded_ids={@expanded_outline_ids}
            comment_ids={@expanded_comment_ids}
            path_ids={@selected_path_ids}
            graph={@graph_struct}
            params={reader_nav_params(@nav_params, @path_focus_ids)}
            can_focus={@can_choose_path?}
            focused={@paths_filtered?}
          />
        <% end %>
      </aside>

      <section
        aria-label="Conversation reader"
        id="outline-detail"
        class="order-1 min-h-0 min-w-0 overflow-visible lg:order-none lg:overflow-y-auto"
        phx-hook="ReaderScroll"
        data-reader-scroll-key={"reader-position:#{@graph_struct.slug}"}
        data-selected-reader-node-id={@selected_node_id}
      >
        <%= if @node do %>
          <div class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-4 pb-4 sm:pt-2 lg:px-6">
            <section id="outline-mobile-nav" class="contents lg:hidden">
              <div
                id="outline-mobile-nav-panel"
                role="dialog"
                aria-modal="true"
                aria-labelledby="outline-mobile-nav-title"
                class="fixed inset-x-0 bottom-0 top-[4.75rem] z-40 hidden overflow-y-auto border-y border-slate-200 bg-white opacity-0 shadow-[0_14px_24px_-20px_rgba(15,23,42,0.25)] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] translate-x-8 pointer-events-none"
              >
                <div class="sticky top-0 z-10 border-b border-slate-200 bg-slate-50 px-5 py-3">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400">
                        Browse
                      </p>
                      <h2
                        id="outline-mobile-nav-title"
                        class="mt-1 text-sm font-semibold text-slate-900"
                      >
                        Grid outline
                      </h2>
                      <p class="mt-1 text-xs text-slate-500">
                        Follow an idea that interests you.
                      </p>
                    </div>
                    <button
                      id="outline-mobile-nav-close"
                      type="button"
                      aria-label="Close conversation outline"
                      phx-click={JS.dispatch("close-mobile-outline", to: "#outline-layout")}
                      class="shrink-0 rounded-lg p-2 text-slate-600 focus-visible:outline-2 focus-visible:outline-teal-700"
                    >
                      <.icon name="hero-x-mark" class="h-5 w-5" />
                    </button>
                    <button
                      :if={@paths_filtered?}
                      id="outline-mobile-show-all-paths"
                      type="button"
                      phx-click="show_all_paths"
                      class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700 transition hover:border-blue-300 hover:bg-blue-100"
                    >
                      Clear filter <.icon name="hero-x-mark" class="h-3.5 w-3.5" />
                    </button>
                  </div>
                </div>

                <div class="bg-slate-50/70 px-2 py-3">
                  <%= if @outline_nodes == [] do %>
                    <div id="outline-mobile-empty-state" class="px-4 py-8 text-sm text-slate-500">
                      This graph does not have any visible nodes yet.
                    </div>
                  <% else %>
                    <DialecticWeb.OutlineNavigation.outline_navigation
                      id="outline-mobile"
                      mobile
                      rows={@visible_outline_nodes}
                      selected_id={@selected_node_id}
                      expanded_ids={@expanded_outline_ids}
                      comment_ids={@expanded_comment_ids}
                      path_ids={@selected_path_ids}
                      graph={@graph_struct}
                      params={reader_nav_params(@nav_params, @path_focus_ids)}
                      can_focus={@can_choose_path?}
                      focused={@paths_filtered?}
                    />
                  <% end %>
                </div>
              </div>
            </section>

            <section
              id="outline-reading-flow"
              phx-hook="SearchHighlights"
              data-search-node-id={@search_highlight && @search_highlight.node_id}
              data-search-terms={
                Jason.encode!(if(@search_highlight, do: @search_highlight.terms, else: []))
              }
              class="-mx-4 overflow-hidden border-y border-stone-300 bg-white shadow-sm sm:mx-0 sm:rounded-xl sm:border"
            >
              <%= for {reading_node, index} <- Enum.with_index(@visible_reading_chain) do %>
                <% reading_response_level = Map.get(reading_node, :response_level) %>
                <% selected_reading_node? = reading_node.id == @selected_node_id %>
                <% node_highlights =
                  Enum.filter(@visible_highlights, &(&1.node_id == reading_node.id)) %>
                <% node_highlight_count = length(node_highlights) %>
                <article
                  id={"reading-node-#{reading_node.id}"}
                  tabindex="-1"
                  aria-labelledby={"reading-title-#{reading_node.id}"}
                  data-reading-selected={to_string(selected_reading_node?)}
                  class={[
                    if(index == 0,
                      do: "bg-slate-950 px-4 py-3 text-white sm:px-6 sm:py-4",
                      else: "bg-white px-4 sm:px-6"
                    ),
                    index > 0 &&
                      if(String.trim(reading_node.body_content || "") == "",
                        do: "py-4 sm:py-5",
                        else: "py-5 sm:py-6"
                      ),
                    index > 0 && "border-t border-slate-200"
                  ]}
                >
                  <% bookmarked? = MapSet.member?(@bookmarked_node_ids, reading_node.id) %>
                  <div
                    :if={@search_highlight && @search_highlight.node_id == reading_node.id}
                    id="reader-search-match-notice"
                    role="status"
                    class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-950"
                  >
                    <span>Search matches: “{@search_highlight.query}”</span>
                    <button
                      id="reader-clear-search-matches"
                      type="button"
                      phx-click="clear_search_highlight"
                      class="min-h-11 rounded-md px-2 font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-amber-800"
                    >
                      Clear
                    </button>
                  </div>
                  <%= if index == 0 do %>
                    <div>
                      <%= if String.trim(reading_node.body_content || "") != "" do %>
                        <h2
                          id={"reading-title-#{reading_node.id}"}
                          class="flex items-center gap-2 text-xs font-medium text-teal-200"
                        >
                          <img src={~p"/images/favicon-32.png"} alt="" class="h-5 w-5" />
                          Starting question
                        </h2>
                        <div
                          id={"reading-prompt-#{reading_node.id}"}
                          class="reader-prose reader-prose-dark prose prose-invert mt-3 max-w-none break-words prose-headings:tracking-tight prose-a:break-words"
                        >
                          <div data-reader-body>
                            <p
                              id={"reading-prompt-opening-#{reading_node.id}"}
                              data-reader-prompt-opening
                            >
                              {reading_node.full_title || reading_node.title}
                            </p>
                          </div>
                          <div
                            id={"reading-highlight-#{reading_node.id}"}
                            phx-hook="TextSelectionHook"
                            data-node-id={reading_node.id}
                            data-mudg-id={@graph_id}
                            data-highlights-only="false"
                          >
                            <div
                              phx-hook="Markdown"
                              phx-update="ignore"
                              id={"outline-markdown-body-#{reading_node.id}"}
                              data-md={reading_node.content || ""}
                              data-grounding={DialecticWeb.MarkdownGrounding.encode(reading_node)}
                              data-body-only="true"
                              data-enhance-follow-up-questions="false"
                            >
                              <div
                                data-role="server-markdown-fallback"
                                class="whitespace-pre-wrap"
                              >
                                {reading_node.body_content}
                              </div>
                            </div>
                          </div>
                        </div>
                      <% else %>
                        <p class="flex items-center gap-2 text-xs font-medium text-teal-200">
                          <img src={~p"/images/favicon-32.png"} alt="" class="h-5 w-5" />
                          Starting question
                        </p>
                        <h2
                          id={"reading-title-#{reading_node.id}"}
                          class="reader-heading reader-question-title mt-1 break-words font-semibold leading-snug text-white"
                        >
                          {reading_node.full_title || reading_node.title}
                        </h2>
                      <% end %>
                    </div>
                  <% else %>
                    <header id={"reader-node-header-#{reading_node.id}"}>
                      <div class="flex flex-wrap items-center gap-2 text-[13px] font-medium text-slate-500 sm:text-sm">
                        <span>Then</span>
                        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                        <span
                          id={"reader-contributor-#{reading_node.id}"}
                          class={[
                            "inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold",
                            DialecticWeb.ColUtils.badge_class(reading_node.class)
                          ]}
                        >
                          {contribution_label(reading_node, @contributor_names)}
                        </span>
                        <span
                          :if={response_level_label(reading_response_level)}
                          id={"reader-response-level-#{reading_node.id}"}
                          data-response-level={reading_response_level}
                          class={[
                            "inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ring-inset",
                            response_level_badge_class(reading_response_level)
                          ]}
                          title={
                            "Generated using the #{response_level_label(reading_response_level)} answer level"
                          }
                        >
                          <.icon name="hero-square-3-stack-3d" class="h-3 w-3" />
                          {response_level_label(reading_response_level)} level
                        </span>
                        <DialecticWeb.NodeReadingTools.node_actions
                          prefix="reader"
                          node_id={reading_node.id}
                          bookmarked?={bookmarked?}
                          highlight_count={node_highlight_count}
                          open?={@node_highlights_open == reading_node.id}
                        />
                      </div>
                      <DialecticWeb.NodeReadingTools.node_highlights
                        prefix="reader"
                        node_id={reading_node.id}
                        graph_id={@graph_id}
                        highlights={node_highlights}
                        open?={@node_highlights_open == reading_node.id}
                      />
                      <h2
                        id={"reading-title-#{reading_node.id}"}
                        class="reader-heading reader-title mt-3 break-words font-semibold leading-[1.15] tracking-tight text-slate-950"
                      >
                        {reading_node.full_title || reading_node.title}
                      </h2>
                    </header>

                    <DialecticWeb.SourceStatus.source_status
                      node={reading_node}
                      id={"reader-source-status-#{reading_node.id}"}
                    />
                    <DialecticWeb.SourceStatus.action_targets
                      node={reading_node}
                      id={"reader-action-targets-#{reading_node.id}"}
                    />
                    <%= cond do %>
                      <% MapSet.member?(@selection_pending_node_ids, reading_node.id) -> %>
                        <DialecticWeb.GenerationComponents.response_placeholder
                          id={"reader-generation-#{reading_node.id}"}
                          status_id={"reader-generation-status-#{reading_node.id}"}
                          response_level={reading_node.response_level}
                          label="Generating an AI response…"
                          class="mt-8"
                        />
                      <% String.trim(reading_node.content || "") == "" -> %>
                        <div
                          id={"reader-generation-#{reading_node.id}"}
                          role="status"
                          class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-10 text-center text-sm text-slate-500"
                        >
                          This node does not have content yet.
                        </div>
                      <% true -> %>
                        <%= if String.trim(reading_node.body_content || "") != "" do %>
                          <div
                            id={"reading-highlight-#{reading_node.id}"}
                            class="mt-4 w-full"
                            phx-hook="TextSelectionHook"
                            data-node-id={reading_node.id}
                            data-mudg-id={@graph_id}
                            data-highlights-only="false"
                          >
                            <article class="reader-prose prose prose-slate max-w-none prose-headings:tracking-tight prose-a:break-words">
                              <div
                                phx-hook="Markdown"
                                phx-update="ignore"
                                id={"outline-markdown-body-#{reading_node.id}"}
                                data-md={reading_node.content || ""}
                                data-grounding={
                                  DialecticWeb.MarkdownGrounding.encode(reading_node)
                                }
                                data-body-only="true"
                                data-follow-up-node-id={reading_node.id}
                                data-enhance-follow-up-questions={to_string(@can_edit)}
                                data-existing-follow-up-questions={
                                  GraphHelpers.existing_follow_up_questions_json(reading_node)
                                }
                              >
                                <div
                                  data-role="server-markdown-fallback"
                                  class="whitespace-pre-wrap"
                                >
                                  {reading_node.body_content}
                                </div>
                              </div>
                            </article>
                          </div>
                        <% end %>
                    <% end %>

                    <div
                      id={"reader-node-actions-#{reading_node.id}"}
                      class="mt-6 space-y-3 border-t border-slate-200 pt-4"
                    >
                      <%= if @can_edit && contribution_target?(reading_node) do %>
                        <% response_label = response_action_label(reading_node) %>
                        <% drawer_open? = @answer_drawer_node_id == reading_node.id %>
                        <button
                          id={"outline-reading-node-#{reading_node.id}-ask"}
                          type="button"
                          phx-click="toggle_answer_drawer"
                          phx-value-id={reading_node.id}
                          aria-expanded={to_string(drawer_open?)}
                          aria-controls={"reader-answer-drawer-#{reading_node.id}"}
                          aria-label={
                            if(drawer_open?, do: "Hide response form", else: response_label)
                          }
                          class="inquiry-disclosure group w-full border-stone-300 bg-white py-2 pl-2 pr-3 text-left"
                        >
                          <span class="inquiry-disclosure-icon">
                            <.icon name="hero-chat-bubble-left-right" class="h-4 w-4" />
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="block text-sm font-semibold">
                              {if(drawer_open?, do: "Hide response form", else: response_label)}
                            </span>
                            <span class="mt-0.5 block text-xs font-normal leading-5 text-slate-500">
                              Ask AI a follow-up or post your own thought.
                            </span>
                          </span>
                          <.icon
                            name="hero-chevron-down"
                            class={[
                              "h-4 w-4 shrink-0 text-slate-400 transition-transform group-hover:text-teal-700 motion-reduce:transition-none",
                              drawer_open? && "rotate-180 text-teal-700"
                            ]}
                          />
                        </button>
                      <% end %>
                      <%= if @can_edit && contribution_target?(reading_node) do %>
                        <% drawer_open? = @answer_drawer_node_id == reading_node.id %>
                        <div
                          id={"reader-answer-drawer-#{reading_node.id}"}
                          hidden={!drawer_open?}
                          class="col-span-full"
                        >
                          <div
                            :if={drawer_open?}
                            id={"reader-answer-actions-hook-#{reading_node.id}"}
                            phx-hook="SelectionActions"
                            class="col-span-full"
                          >
                            <.live_component
                              module={DialecticWeb.SelectionActionsComp}
                              prompt_mode={@graph_struct.prompt_mode || "university"}
                              id={"answer-actions-#{reading_node.id}"}
                              context={:answer}
                              presentation={:drawer}
                              node_id={reading_node.id}
                              answer_title={
                                NodeTitleHelper.extract_node_title(reading_node, max_length: 180)
                              }
                              bookmarked={MapSet.member?(@bookmarked_node_ids, reading_node.id)}
                              trigger_id={"outline-reading-node-#{reading_node.id}-ask"}
                              current_user={@current_user}
                              graph_id={@graph_id}
                              can_edit={@can_edit}
                            />
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </article>
              <% end %>
            </section>

            <%= cond do %>
              <% @paths_filtered? -> %>
              <% @next_choices != [] -> %>
                <section
                  id="outline-next-choices"
                  class="rounded-[1.65rem] border border-slate-200 bg-white p-4 shadow-sm sm:rounded-2xl sm:p-6"
                >
                  <h3 class="text-xl font-semibold tracking-tight text-slate-950">
                    Choose a path from here
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-slate-500">
                    {next_choices_message(@reading_terminal, @node)}
                  </p>

                  <ul class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white">
                    <%= for choice <- @next_choices do %>
                      <li>
                        <DialecticWeb.PathActionCardComp.path_action_card
                          id={"next-choice-#{choice.id}"}
                          patch={
                            graph_path(
                              @graph_struct,
                              choice.id,
                              reader_nav_params(@nav_params, @path_focus_ids)
                            )
                          }
                          title={choice.title}
                          node_class={choice.class}
                          loading={MapSet.member?(@selection_pending_node_ids, choice.id)}
                        />
                      </li>
                    <% end %>
                  </ul>
                </section>
              <% true -> %>
                <section
                  id="outline-end-state"
                  class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 p-6 text-white shadow-[0_18px_40px_rgba(15,23,42,0.18)]"
                >
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="max-w-2xl">
                      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-200/80">
                        Continue this thread
                      </p>
                      <h3 class="mt-2 text-xl font-semibold tracking-tight text-white">
                        This path ends here for now.
                      </h3>
                      <%= if @can_edit do %>
                        <p class="mt-2 text-sm leading-6 text-slate-300">
                          Share your perspective, offer an example, or ask a follow-up to continue the discussion.
                        </p>
                      <% else %>
                        <p class="mt-3 text-xs font-medium text-amber-200/90">
                          {if(@graph_struct.is_locked,
                            do: "The owner has turned off contributions to this grid.",
                            else: "Sign in or create an account to continue the discussion."
                          )}
                        </p>
                      <% end %>
                    </div>

                    <%= if @can_edit && @reading_terminal do %>
                      <button
                        id="outline-end-follow-up"
                        type="button"
                        phx-click="open_follow_up"
                        phx-value-id={@reading_terminal.id}
                        class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-teal-900 hover:bg-teal-50"
                      >
                        <.icon name="hero-chat-bubble-left-right" class="h-4 w-4" />
                        Ask a follow-up
                      </button>
                    <% end %>
                  </div>
                </section>
            <% end %>

            <DialecticWeb.WorkspaceBarComp.contribution_sign_in
              :if={!@current_user && !@graph_struct.is_locked}
              id="reader-contribution-sign-in"
            />

            <% inactive_branches = Enum.reject(@compare_branches, & &1.active?) %>
            <% compare_section_hidden? =
              @compare_context && @reading_terminal &&
                @compare_context.root.id == @reading_terminal.id %>
            <%= if !@paths_filtered? && @compare_context && inactive_branches != [] && !compare_section_hidden? do %>
              <section
                id="outline-branch-compare"
                class="rounded-[1.65rem] border border-slate-200 bg-white p-4 shadow-sm sm:rounded-2xl sm:p-6"
              >
                <h3 class="text-xl font-semibold tracking-tight text-slate-950">
                  Other paths you could read
                </h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  Earlier, at <span class="font-medium text-slate-700">{@compare_context.root.title}</span>,
                  the conversation split. If this is not the thread you want, you can switch to {pluralize(
                    length(inactive_branches),
                    " the other path",
                    " one of the other paths"
                  )} below.
                </p>

                <ul class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white">
                  <%= for branch <- inactive_branches do %>
                    <li>
                      <DialecticWeb.PathActionCardComp.path_action_card
                        id={"branch-compare-card-#{branch.id}"}
                        patch={
                          graph_path(
                            @graph_struct,
                            branch.id,
                            reader_nav_params(@nav_params, @path_focus_ids)
                          )
                        }
                        title={branch.lead.full_title}
                        node_class={branch.lead.class}
                        loading={MapSet.member?(@selection_pending_node_ids, branch.lead.id)}
                      />
                    </li>
                  <% end %>
                </ul>
              </section>
            <% end %>
          </div>
        <% else %>
          <div class="flex h-full items-center justify-center px-6 py-12 text-center">
            <div class="max-w-md rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
              <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100">
                <.icon name="hero-bars-3-bottom-left" class="h-7 w-7 text-slate-500" />
              </div>
              <h2 class="mt-4 text-lg font-semibold text-slate-900">No node selected</h2>
              <p class="mt-2 text-sm leading-6 text-slate-500">
                Pick a node from the outline to inspect its content and nearby branches.
              </p>
            </div>
          </div>
        <% end %>
      </section>

      <DialecticWeb.WorkspaceBarComp.tools_drawer
        id="grid-history-panel"
        layout_target="#outline-layout"
        mode={:reader}
        title="Grid history"
        subtitle="How this grid was built"
      >
        <.live_component
          module={DialecticWeb.GridHistoryComp}
          id="grid-history-comp"
          graph_id={@graph_id}
          graph_struct={@graph_struct}
          creator={@graph_creator}
        />
      </DialecticWeb.WorkspaceBarComp.tools_drawer>

      <DialecticWeb.WorkspaceBarComp.tools_drawer
        id="right-panel"
        layout_target="#outline-layout"
        mode={:reader}
      >
        <.live_component
          module={DialecticWeb.RightPanelComp}
          id="right-panel-comp"
          highlights_count={length(@visible_highlights)}
          mode={:reader}
          layout_target="#outline-layout"
          graph_id={@graph_id}
          graph_struct={@graph_struct}
          node={@node}
          current_user={@current_user}
          reader_style={@reader_style}
          prompt_mode={@graph_struct.prompt_mode || "university"}
          following_graph?={@following_graph?}
          token={@token}
        />
      </DialecticWeb.WorkspaceBarComp.tools_drawer>

      <div
        id="highlights-drawer"
        data-right-drawer
        class="fixed inset-y-0 right-0 z-50 w-0 overflow-hidden border-l border-slate-200 bg-slate-50 opacity-0 shadow-[-20px_0_45px_-32px_rgba(15,23,42,0.35)] transform translate-x-full transition-all duration-300 ease-in-out lg:absolute"
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-5 py-4">
            <div class="flex min-w-0 items-center gap-3">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200/70">
                <.icon name="hero-pencil" class="h-5 w-5" />
              </span>
              <div class="min-w-0">
                <h2 class="text-base font-semibold tracking-tight text-slate-950">Highlights</h2>
                <p class="mt-0.5 text-xs leading-5 text-slate-500">
                  {length(@visible_highlights)} saved {if(length(@visible_highlights) == 1,
                    do: "passage",
                    else: "passages"
                  )} and connected ideas
                </p>
              </div>
            </div>

            <button
              id="reader-highlights-close"
              type="button"
              phx-click={
                JS.dispatch("toggle-panel",
                  to: "#outline-layout",
                  detail: %{id: "highlights-drawer"}
                )
              }
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600"
              aria-label="Close highlights panel"
              title="Close panel"
            >
              <.icon name="hero-x-mark" class="h-4 w-4" />
            </button>
          </div>

          <div class="min-h-0 flex-1 overflow-y-auto px-4 pt-4 sm:px-5">
            <.live_component
              module={DialecticWeb.HighlightsPanelComp}
              id="reader-highlights-panel"
              highlights={@visible_highlights}
              current_user={@current_user}
              graph_struct={@graph_struct}
              graph_id={@graph_id}
              visible_node_ids={MapSet.to_list(@highlight_node_ids)}
            />
          </div>
        </div>
      </div>
    </div>

    <div phx-hook="SelectionActions" id="reader-selection-actions-hook">
      <.live_component
        module={DialecticWeb.SelectionActionsComp}
        prompt_mode={@graph_struct.prompt_mode || "university"}
        id="selection-actions"
        current_user={@current_user}
        graph_id={@graph_id}
        can_edit={@can_edit}
      />
    </div>
  </div>

  <%= if assigns[:graph_id] do %>
    <div id="outline-quick-search-container" phx-window-keydown="open_search_overlay" phx-key="k">
      <%= if @show_search_overlay do %>
        <button
          type="button"
          id="outline-quick-search-backdrop"
          class="fixed inset-0 z-[9990] border-0 bg-black/20 p-0"
          phx-click="close_search_overlay"
          aria-label="Close search overlay"
          tabindex="-1"
          aria-hidden="true"
        ></button>

        <div
          id="outline-quick-search-panel"
          class="fixed left-1/2 top-12 z-[9991] max-h-[calc(100dvh-4rem)] w-full max-w-md -translate-x-1/2 overflow-y-auto px-2 sm:top-24 sm:max-h-[calc(100dvh-7rem)] sm:px-4"
          phx-window-keydown="close_search_overlay"
          phx-key="Escape"
          phx-hook="SearchNav"
          data-focus-result-prefix="reading-node-"
          data-return-focus-id="reader-workspace-bar-search"
        >
          <div
            class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-2xl"
            role="dialog"
            aria-modal="true"
            aria-labelledby="outline-quick-search-title"
          >
            <div class="flex items-center gap-2 border-b border-gray-100 px-4 py-3">
              <.icon name="hero-magnifying-glass" class="h-5 w-5 shrink-0 text-gray-400" />
              <h2 id="outline-quick-search-title" class="sr-only">Search topics</h2>

              <.form
                for={@reader_search_form}
                id="outline-quick-search-form"
                phx-change="search_nodes"
                phx-submit="search_nodes"
                class="min-w-0 flex-1"
              >
                <label for="outline-quick-search-input" class="sr-only">Search topics</label>
                <.input
                  type="text"
                  field={@reader_search_form[:search_term]}
                  id="outline-quick-search-input"
                  placeholder="Search this conversation…"
                  class="w-full border-0 bg-transparent p-0 text-base text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-0 sm:text-sm"
                  autocomplete="off"
                  phx-debounce="200"
                />
              </.form>

              <button
                id="outline-quick-search-close"
                type="button"
                phx-click="close_search_overlay"
                aria-label="Close search"
                class="inline-flex min-h-11 min-w-11 items-center justify-center shrink-0 rounded-lg p-2 text-slate-600 focus-visible:outline-2 focus-visible:outline-teal-700"
              >
                <.icon name="hero-x-mark" class="h-5 w-5" />
              </button>
            </div>

            <p
              id="outline-search-status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              class="px-4 pt-2 text-xs leading-5 text-slate-600"
            >
              <%= if @search_term != "" do %>
                {@search_result_count} {if(@search_result_count == 1,
                  do: "topic",
                  else: "topics"
                )} found for {@search_term}.
                <span :if={@search_result_count > length(@search_results)}>
                  Showing {length(@search_results)}.
                </span>
              <% end %>
            </p>
            <%= if (@search_term || "") != "" do %>
              <div class="max-h-[55dvh] overflow-y-auto overscroll-contain sm:max-h-72">
                <%= if @search_results != [] do %>
                  <ul class="py-1">
                    <%= for node <- @search_results do %>
                      <li>
                        <button
                          id={"outline-search-result-#{node.id}"}
                          type="button"
                          phx-click="search_result_clicked"
                          phx-value-id={node.id}
                          class="w-full cursor-pointer px-4 py-2.5 text-left transition-colors hover:bg-indigo-50 focus:bg-indigo-50 focus:outline-none"
                        >
                          <div class="flex items-center gap-2">
                            <span class={[
                              "inline-block h-2 w-2 shrink-0 rounded-full",
                              node.class == "question" && "bg-sky-400",
                              node.class == "user" && "bg-sky-400",
                              node.class == "thesis" && "bg-emerald-400",
                              node.class == "antithesis" && "bg-rose-400",
                              node.class == "synthesis" && "bg-purple-400",
                              node.class == "ideas" && "bg-orange-400",
                              node.class == "learning_plan" && "bg-indigo-500",
                              node.class == "origin" && "bg-slate-400",
                              node.class not in ~w(question user thesis antithesis synthesis ideas learning_plan origin) &&
                                "bg-gray-400"
                            ]} />
                            <span class="shrink-0 text-xs text-gray-400">
                              {node.class}
                            </span>
                          </div>

                          <div class="mt-0.5 break-words text-sm font-medium text-gray-900">
                            {Map.get(node, :full_title) || Map.get(node, :title)}
                          </div>

                          <%= if Map.get(node, :search_preview) do %>
                            <div class="mt-1.5 flex items-start gap-2 text-left">
                              <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-gray-500">
                                {Map.get(node, :search_preview_label)}
                              </span>
                              <p class="line-clamp-2 text-xs leading-5 text-gray-500">
                                {Map.get(node, :search_preview)}
                              </p>
                            </div>
                          <% end %>
                        </button>
                      </li>
                    <% end %>
                  </ul>
                  <button
                    :if={length(@search_results) < @search_result_count}
                    id="outline-search-more"
                    type="button"
                    phx-click="show_more_search_results"
                    class="min-h-11 w-full border-t border-slate-200 px-4 py-3 text-sm font-semibold text-teal-800 hover:bg-teal-50 focus-visible:outline-2 focus-visible:outline-teal-700"
                  >
                    Show more results
                  </button>
                <% else %>
                  <div class="px-4 py-6 text-center">
                    <p class="text-sm text-gray-500">No topics found for "{@search_term}"</p>
                    <p class="mt-2 text-sm text-slate-600">
                      Try fewer words or a different term.
                    </p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="px-4 py-4 text-center">
                <p class="text-xs text-gray-400">
                  Search titles, responses and source passages in this conversation. Words can appear in any order.
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <.live_component
    module={DialecticWeb.ShareModalComp}
    id="outline-share-modal"
    show={@show_share_modal}
    graph_struct={@graph_struct}
    current_user={@current_user}
    selected_node={@share_node}
    selected_highlight={@selected_share_highlight}
    share_node={true}
    share_target={:reader}
    reader_path_endpoint={List.last(@path_focus_ids)}
    show_preview={false}
  />
</Layouts.app>
