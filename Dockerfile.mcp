FROM node:24.15.0-bookworm-slim AS build
WORKDIR /app
COPY mcp/package.json mcp/package-lock.json ./
RUN npm ci
COPY mcp/src ./src
COPY mcp/ui ./ui
COPY mcp/tsconfig.json mcp/tsconfig.ui.json mcp/build-ui.mjs ./
RUN npm run build && npm prune --omit=dev

FROM node:24.15.0-bookworm-slim
ENV NODE_ENV=production MCP_HOST=0.0.0.0 MCP_PORT=4001
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 4001
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:4001/health').then(r => {if (!r.ok) process.exit(1)}).catch(() => process.exit(1))"
CMD ["node", "dist/index.js"]
